# Variables que lee docker-compose. Copia este archivo a .env:
#   cp .env.docker.example .env

# Secreto para firmar JWT (cámbialo por algo largo y aleatorio).
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Clave de Google Gemini. NUNCA se expone al frontend; solo la usa el backend.
# Regénerala si la anterior fue filtrada.
GEMINI_API_KEY=tu_clave_aqui
GEMINI_MODEL=gemini-2.5-flash-lite

# Límite de llamadas IA por estudiante por hora.
AI_RATE_LIMIT_PER_HOUR=20
