# ── Servidor ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Origen permitido para CORS (frontend Vite)
CLIENT_ORIGIN=http://localhost:5173

# ── Base de datos PostgreSQL ───────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prexi

# ── Autenticación ──────────────────────────────────────────
# Cambiar por un secreto largo y aleatorio en producción
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# ── IA (Google Gemini) ─────────────────────────────────────
# NUNCA se expone al frontend. Regenera la clave si fue filtrada.
GEMINI_API_KEY=tu_clave_aqui
GEMINI_MODEL=gemini-2.0-flash

# Límite de llamadas IA por estudiante por hora
AI_RATE_LIMIT_PER_HOUR=20
