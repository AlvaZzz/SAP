{
  "name": "@prexi/api",
  "version": "1.0.0",
  "private": true,
  "description": "PREXI UPEA — API NestJS (Screaming Architecture)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "crear-admin": "ts-node scripts/crear-admin.ts",
    "diagnostico:ia": "ts-node scripts/diagnostico-ia.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "seed:demo": "ts-node prisma/seed-demo.ts",
    "seed:practica": "ts-node prisma/seed-practica-u1u2.ts",
    "clave:informe": "ts-node scripts/clave-distribucion.ts",
    "clave:migrar": "ts-node scripts/equilibrar-clave-bd.ts",
    "clave:migrar:aplicar": "ts-node scripts/equilibrar-clave-bd.ts --aplicar",
    "tutor:renombrar": "ts-node scripts/renombrar-tutor-bd.ts",
    "tutor:renombrar:aplicar": "ts-node scripts/renombrar-tutor-bd.ts --aplicar"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^30.4.2",
    "prettier": "^3.9.4",
    "prisma": "^6.2.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
