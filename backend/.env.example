# ── API NestJS ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ── Base de datos (Prisma / PostgreSQL) ────────────────────
DATABASE_URL=postgresql://prexi:prexi@localhost:5432/prexi?schema=public

# ── Autenticación ──────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# ── Recuperación de contraseña / Correo (SMTP) ─────────────
# URL pública del FRONTEND: se usa para armar el enlace de restablecimiento
# (APP_URL/restablecer-contrasena?token=...).
APP_URL=http://localhost:3000
# SMTP OPCIONAL. Si SMTP_HOST está vacío, el enlace de recuperación se imprime
# en los logs del backend (útil en desarrollo). Para enviar correo real:
#   1) npm i nodemailer   (dependencia opcional)
#   2) completa estas variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PREXI <no-reply@prexi.local>

# ── IA (Google Gemini) — solo backend, nunca al cliente ────
# Usar la variante FLASH (rápida y económica). El admin puede cambiar el modelo
# en caliente desde /admin/config (ConfiguracionSistema.modeloIa).
GEMINI_API_KEY=tu_clave_aqui
GEMINI_MODEL=gemini-2.5-flash-lite
AI_RATE_LIMIT_PER_HOUR=20

# ── Sandbox de ejecución de código (Piston self-hosted) ────
# Contenedor Piston en docker-compose; el backend NUNCA ejecuta
# el código del estudiante en su propio proceso.
PISTON_URL=http://piston:2000

# ── Subida de documentos (PDF del docente) ─────────────────
# Carpeta física de almacenamiento (fuera de src). En producción/Docker
# apúntala a un volumen persistente. La ruta NUNCA se expone al cliente.
UPLOAD_DIR=./uploads/documentos
# Tamaño máximo del PDF en bytes (por defecto 15 MB).
MAX_PDF_BYTES=15728640
