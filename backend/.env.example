# ── API NestJS ─────────────────────────────────────────────
# PORT: en Render lo inyecta la plataforma; NO lo definas manualmente allí.
PORT=4000
# NODE_ENV=production es lo que activa `secure: true` en las cookies de sesión.
# En Render DEBE valer production o el navegador rechazará la cookie sobre HTTPS.
NODE_ENV=development
# Origen del frontend, para CORS con credenciales (main.ts).
# En producción: la URL de Vercel, p. ej. https://prexi.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# ── Base de datos (Prisma / PostgreSQL) ────────────────────
# DATABASE_URL: la usa la APLICACIÓN. En Neon es la cadena POOLED (contiene
#   `-pooler` en el host) y debe llevar `?sslmode=require`.
# DIRECT_URL:   la usan las MIGRACIONES y el seed (DDL). En Neon es la cadena
#   DIRECTA (sin `-pooler`). Prisma la lee vía `directUrl` en schema.prisma.
# En local ambas apuntan a la misma base.
DATABASE_URL=postgresql://prexi:prexi@localhost:5433/prexi?schema=public
DIRECT_URL=postgresql://prexi:prexi@localhost:5433/prexi?schema=public

# ── Autenticación ──────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=15m

# ── Recuperación de contraseña / Correo (SMTP) ─────────────
# URL pública del FRONTEND. Dos usos, no uno:
#   1) arma el enlace de restablecimiento (APP_URL/restablecer-contrasena?token=…)
#   2) es el origen que acepta el OrigenGuard en las mutaciones (defensa CSRF)
# En producción DEBE ser la URL real de Vercel (misma que CLIENT_ORIGIN).
APP_URL=http://localhost:3000
# SMTP OPCIONAL. Si SMTP_HOST está vacío, el enlace de recuperación se imprime
# en los logs del backend (útil en desarrollo). Para enviar correo real:
#   1) npm i nodemailer   (dependencia opcional)
#   2) completa estas variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PREXI <no-reply@prexi.local>

# ── IA (Google Gemini) — solo backend, nunca al cliente ────
# Usar la variante FLASH (rápida y económica). El admin puede cambiar el modelo
# en caliente desde /admin/config (ConfiguracionSistema.modeloIa).
GEMINI_API_KEY=tu_clave_aqui
GEMINI_MODEL=gemini-2.5-flash-lite
AI_RATE_LIMIT_PER_HOUR=20

# ── Ejecución del código del estudiante ────────────────────
# No hay sandbox del lado del servidor: el Python del estudiante corre en SU
# navegador con Pyodide (frontend/src/lib/python-runtime.ts). El backend nunca
# ejecuta código de terceros. Sin variables que configurar aquí.

# ── Subida de documentos (PDF del docente) ─────────────────
# Los PDF se guardan DENTRO de PostgreSQL (columna binaria de `documentos`), no
# en disco: Render Free tiene filesystem efímero y los perdería en cada
# reinicio. No hay carpeta que configurar.
# Tamaño máximo del PDF en bytes (por defecto 15 MB). Ojo con el límite de
# almacenamiento de Neon Free (0.5 GB para TODA la base).
MAX_PDF_BYTES=15728640

# ── Defensa CSRF (OrigenGuard) ─────────────────────────────
# Toda mutación debe venir de un origen permitido. La lista se arma con APP_URL
# (arriba) + esta variable, separada por comas. Si en producción APP_URL no es
# la URL real de Vercel, TODAS las mutaciones responderán 403.
ORIGENES_PERMITIDOS=
