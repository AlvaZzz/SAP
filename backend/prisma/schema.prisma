// ════════════════════════════════════════════════════════════
//  PREXI UPEA — Esquema Prisma (PostgreSQL)
//  Rol estudiante: Python + IA (PREXI/Gemini) + gamificación.
// ════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

// `url` la usa la APLICACIÓN; en Neon debe ser la cadena POOLED (host con
// `-pooler`). `directUrl` la usan las MIGRACIONES y el seed, que necesitan una
// conexión directa sin pooler para hacer DDL. Ambas exigen `sslmode=require`
// en Neon. En local las dos apuntan a la misma base.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ───────────────────────────────────────────────────
enum Rol {
  estudiante
  docente
  admin
  investigador
}

enum TipoEjercicio {
  opcion_multiple
  predecir_salida
  completar_codigo
  ordenar_lineas
}

// Nivel de dificultad ADAPTATIVO (discreto). Cada ejercicio de práctica
// pertenece a uno; cada tema tiene ejercicios en los tres. El estudiante ve, en
// cada tema, los de SU nivel actual (Teoría de Respuesta al Ítem). El nivel es
// por-tema y puede subir con un mini-diagnóstico ≥ umbral.
enum NivelDificultad {
  basico
  intermedio
  avanzado
}

// Estado de una pregunta propuesta por PREXI desde un PDF: nunca se publica
// sola, siempre pasa por revisión humana del docente.
// Resultado GRADUADO de una respuesta (ver ejercicios/correccion.ts).
enum EstadoRespuesta {
  correcta
  parcial
  incorrecta
}

enum EstadoPreguntaIa {
  borrador
  aprobada
  rechazada
}

enum Banco {
  practica
  pretest
  postest
  examen // examen de fin de unidad (instrumento interno de avance, gestionado por el docente)
}

enum TipoTest {
  pre
  post
}

enum ContextoCodigo {
  libre
  ejercicio
  reto
}

// Estado de la entrega de un reto por parte del estudiante.
enum EstadoEntrega {
  sin_entregar // aún no lo entrega (solo lo está resolviendo)
  pendiente_revision // entregado, esperando al docente (sin XP todavía)
  aprobado // el docente lo aprobó → XP otorgado
  necesita_mejorar // el docente pide correcciones → puede reenviar
}

// ── Usuarios ────────────────────────────────────────────────
model Usuario {
  id           Int     @id @default(autoincrement())
  // Nombre COMPLETO ("Paterno Materno Nombres"). En los estudiantes registrados
  // por el docente se DERIVA de los tres campos de abajo; se conserva como
  // columna para no romper las vistas que ya lo muestran.
  nombre       String
  apellidoPaterno String? @map("apellido_paterno")
  apellidoMaterno String? @map("apellido_materno")
  nombres         String?
  // Opcional: los estudiantes que registra el docente desde su lista no tienen
  // correo; entran con su RU.
  email        String? @unique
  // CI (cédula de identidad). Es la contraseña INICIAL del estudiante importado.
  cedula       String? @unique
  // RU (registro universitario). Usuario de acceso del estudiante importado.
  ru           String? @unique
  rol          Rol     @default(estudiante)
  carrera      String?
  // Institución/cohorte para el desglose del estudio (UPEA, EMI, preuniversitario…).
  institucion  String?
  passwordHash String  @map("password_hash")

  // Gate de la fase de INTRODUCCIÓN didáctica: el diagnóstico (pretest) solo se
  // habilita una vez que el estudiante revisa las introducciones de las 5 unidades.
  introduccionCompletada Boolean          @default(false) @map("introduccion_completada")
  // Gate del REPASO previo al postest (evaluación final): el postest solo se
  // habilita tras revisar el repaso de cierre (además del switch del docente).
  repasoPostestCompletado Boolean         @default(false) @map("repaso_postest_completado")
  pretestCompletado      Boolean          @default(false) @map("pretest_completado")
  nivelInicial           Int              @default(1) @map("nivel_inicial")
  // Clasificación adaptativa PERMANENTE del pretest (Básico/Intermedio/Avanzado):
  // se fija una sola vez y NO cambia (instrumento de la investigación). El nivel
  // que sí cambia es el de cada tema (ProgresoTema.nivelActual).
  nivelInicialAdaptativo NivelDificultad? @map("nivel_inicial_adaptativo")

  // ── HABILIDAD ESTIMADA POR IRT (modelo de Rasch), en logits (escala de θ) ──
  //  θ_inicial: estimada del PRETEST por máxima verosimilitud (diagnóstico).
  //  θ_actual : re-estimada de forma continua con la práctica (nivel vigente).
  //  θ_final  : estimada de la EVALUACIÓN FINAL del curso (postest).
  //  θ es parte del motor adaptativo (ver src/mediciones/irt). El estudio es no
  //  experimental transversal: NO compara θ_inicial contra θ_final.
  thetaInicial Float? @map("theta_inicial")
  thetaActual  Float? @map("theta_actual")
  thetaFinal   Float? @map("theta_final")

  // Paralelo (ej. "A", "B", "C") y semestre del estudiante.
  // `paraleloId` es la relación real (Materia → Paralelo → docente). `paralelo`
  // guarda el NOMBRE del paralelo, sincronizado, porque ranking, evaluación
  // final y exportaciones ya filtran por ese texto.
  paralelo   String? // solo aplica a estudiantes; null en docente/admin/investigador
  paraleloId Int?    @map("paralelo_id")
  semestre   Int     @default(1)

  // CONSENTIMIENTO INFORMADO (ética de la investigación). La casilla de
  // aceptación siempre fue obligatoria en el formulario de registro, pero hasta
  // la incorporación de estos campos NO quedaba constancia en la base: por eso
  // son nullables y las cuentas anteriores quedan sin registro verificable, algo
  // que el rol investigador declara explícitamente como limitación en vez de
  // dar por supuesto. Nunca se rellenan retroactivamente.
  consentimientoEn      DateTime? @map("consentimiento_en")
  consentimientoVersion String?   @map("consentimiento_version")

  // Gestión del administrador: soft-disable (no borrar → conserva datos del estudio)
  // y forzado de cambio de contraseña tras un reseteo.
  activo             Boolean @default(true)
  mustChangePassword Boolean @default(false) @map("must_change_password")

  // Seguridad de acceso.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")

  // Onboarding: claves de los tours/tutoriales ya vistos (persistido por usuario,
  // no en localStorage). "Volver a ver los tutoriales" del perfil lo vacía.
  toursVistos String[] @default([]) @map("tours_vistos")

  // Preferencias de AUDIO (persistidas por usuario, respetan el contexto de aula):
  //  · sonidos de gamificación (logros/rango/nivel) — ACTIVADOS por defecto.
  //  · lectura en voz alta automática de PREXI (Web Speech API) — DESACTIVADA
  //    por defecto; el estudiante la activa si quiere.
  sonidosActivados Boolean @default(true) @map("sonidos_activados")
  vozAutomatica    Boolean @default(false) @map("voz_automatica")

  creadoEn DateTime @default(now()) @map("creado_en")

  intentos            Intento[]
  progreso            ProgresoNivel[]
  ranking             Ranking?
  logros              LogroUsuario[]
  evaluaciones        Evaluacion[]
  pretestRespuestas   PretestRespuesta[]
  consultasIa         ConsultaIa[]
  codigos             CodigoPractica[]
  documentos          Documento[]          @relation("DocenteDocumentos")
  retos               Reto[]               @relation("DocenteRetos")
  retosResueltos      RetoUsuario[]
  notificaciones      Notificacion[]
  notasRecibidas      NotaDocente[]        @relation("NotasRecibidas")
  notasEscritas       NotaDocente[]        @relation("NotasEscritas")
  accionesAuditoria   LogAuditoria[]       @relation("AuditoriaActor")
  progresoTemas       ProgresoTema[]
  unidadesCompletadas UnidadCompletada[]
  preguntasGeneradas  PreguntaGenerada[]   @relation("AutorPreguntaIa")
  desempenoUnidades   DesempenoUnidad[]
  pasosRuta           PasoRuta[]
  intentosSubidaNivel IntentoSubidaNivel[]
  tokensRecuperacion  TokenRecuperacion[]
  refreshTokens       RefreshToken[]
  historialTheta      HistorialTheta[]
  diagnosticoTemas    DiagnosticoTema[]
  repasosUnidad       RepasoUnidad[]
  respuestasEncuesta  RespuestaEncuesta[]
  consultasRanking    ConsultaRanking[]
  examenesUnidad      ExamenUnidad[]
  habilitacionesExamen HabilitacionExamen[] @relation("HabilitacionEstudiante")
  habilitacionesDadas  HabilitacionExamen[] @relation("HabilitacionDocente")
  logsAdaptacion      LogAdaptacion[]
  historialRanking    HistorialRanking[]
  respuestasInstrumento RespuestaInstrumento[]
  paraleloRef         Paralelo?            @relation("EstudiantesParalelo", fields: [paraleloId], references: [id], onDelete: SetNull)
  paralelosACargo     Paralelo[]           @relation("DocenteParalelos")

  @@index([paraleloId])

  @@map("usuarios")
}

// ── Evolución de la habilidad θ estimada por IRT (histórico) ─────────────
//  Cada fila es una re-estimación de θ (por máxima verosimilitud, modelo de
//  Rasch) en un momento del uso: al terminar el pretest, durante la práctica,
//  al subir de nivel y en el postest. Permite trazar la EVOLUCIÓN de θ del
//  estudiante y sirve de dato para la investigación (ver src/irt).
model HistorialTheta {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  theta     Float // habilidad estimada (logits)
  origen    String // pretest | practica | subir_nivel | postest
  n         Int      @default(0) // nº de respuestas usadas en la estimación
  temaId    Int?     @map("tema_id") // tema asociado (si aplica: práctica/subida)
  fecha     DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, fecha])
  @@map("historial_theta")
}

// ── Recuperación de contraseña (todos los roles) ────────────
//  Token de un solo uso con expiración corta. En la BD se guarda SOLO el HASH
//  (sha256) del token, nunca el valor en claro: si se filtra la tabla, no se
//  puede reconstruir el enlace. El backend genera el token aleatorio, lo envía
//  por correo y valida su hash al restablecer.
model TokenRecuperacion {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  tokenHash String    @unique @map("token_hash")
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en") // se sella al usarse (un solo uso)
  creadoEn  DateTime  @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_recuperacion")
}

// ── Sesión larga: REFRESH TOKEN (rotatorio, revocable) ──────
//  El access token (JWT en cookie httpOnly) vive 15 min; para no expulsar al
//  estudiante cada 15 minutos se emite además un refresh token opaco.
//
//  Igual que TokenRecuperacion, en la BD se guarda SOLO el hash (sha256): si se
//  filtra la tabla no se puede reconstruir ninguna sesión. Cada uso ROTA el token
//  (se revoca el anterior y se emite uno nuevo), de modo que un token robado y
//  reutilizado se detecta: al llegar uno ya revocado se cortan todas las sesiones
//  del usuario.
model RefreshToken {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  tokenHash  String    @unique @map("token_hash")
  expiraEn   DateTime  @map("expira_en")
  revocadoEn DateTime? @map("revocado_en")
  // "Recordarme": sesión larga (30 días) frente a la corta (1 día).
  recordado  Boolean   @default(false)
  creadoEn   DateTime  @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, revocadoEn])
  @@map("refresh_tokens")
}

// ── Unidades académicas (jerarquía UNIDAD → TEMA → SUBTEMA) ─
//  Estructura curricular real, en paralelo a los 5 "niveles" del sistema de
//  gamificación (que se mantienen para pretest/postest y XP por nivel).
model Unidad {
  id          Int      @id @default(autoincrement())
  numero      Int
  titulo      String
  descripcion String?
  // Introducción teórica DIDÁCTICA de la unidad (Markdown), editable por el
  // docente. Alimenta las pestañas de la fase de introducción previa al
  // diagnóstico (objetivos, conceptos clave, ejemplo, cierre).
  introduccion String? @db.Text
  // Contenido de REPASO/cierre de la unidad (Markdown), editable por el docente.
  // Alimenta la fase de repaso previa al postest (una pestaña por unidad).
  repaso       String? @db.Text
  // ── DASHBOARD DE DESTINO (Preview de Unidad) ──
  //  Se muestra al entrar a la unidad. Objetivos y analogías (Markdown) los edita
  //  el docente; los ejemplos se siembran; el mapa conceptual se deriva del temario.
  dashObjetivos String? @db.Text @map("dash_objetivos")
  dashAnalogias String? @db.Text @map("dash_analogias")
  dashEjemplos  Json?   @map("dash_ejemplos") // [{ titulo, codigo, diagrama, salida }]
  dashMinutos   Int?    @map("dash_minutos")  // tiempo estimado de la unidad (min)
  // Plan/institución del currículo. Permite convivir varios planes (UPEA PRG-111,
  // EMI, preuniversitario…) SIN reescribir: el numero es único POR institución.
  institucion String   @default("UPEA")
  plan        String   @default("PRG-111")
  // XP adicional que se otorga al completar TODOS los temas publicados de la unidad.
  xp          Int      @default(0)
  orden       Int      @default(0)
  // Imagen de PORTADA de la unidad (banner). `imagenUrl` guarda el nombre
  // OPACO (UUID.ext) y `imagenDatos` el binario, que vive DENTRO de la base por
  // el mismo motivo que el PDF de los documentos: el filesystem del hosting
  // gratuito es efímero. Se sirve por streaming desde GET /unidades/:id/portada.
  imagenUrl   String?  @map("imagen_url")
  imagenDatos Bytes?   @map("imagen_datos")
  imagenMime  String?  @map("imagen_mime")
  creadoEn    DateTime @default(now()) @map("creado_en")

  temas       Tema[]
  completadas UnidadCompletada[]
  desempenos  DesempenoUnidad[]
  repasos     RepasoUnidad[]
  examenes    ExamenUnidad[]
  habilitaciones HabilitacionExamen[]

  @@unique([institucion, numero])
  @@map("unidades")
}

// Un Tema pertenece a una Unidad. Si `padreId` está presente, ESTE registro es
// un SUBTEMA del tema referenciado (jerarquía de un solo nivel de profundidad).
model Tema {
  id          Int      @id @default(autoincrement())
  unidadId    Int      @map("unidad_id")
  padreId     Int?     @map("padre_id")
  // Etiqueta jerárquica visible que arma el docente, ej. "1.5" o "1.5.2".
  numero      String   @db.VarChar(20)
  titulo      String
  descripcion String?
  // Contenido de REPASO/cierre del tema (Markdown), editable por el docente.
  // Alimenta la fase de repaso previa al examen de fin de unidad (pestaña por tema).
  repaso      String?  @db.Text
  // Denormalizado desde la unidad para filtrar el contenido por institución/plan.
  institucion String   @default("UPEA")
  orden       Int      @default(0)
  // Ejercicios correctos necesarios para desbloquear el siguiente tema (análogo a Nivel.umbral).
  umbral      Int      @default(10)
  // Requiere MÍNIMO 10 ejercicios activos para poder publicarse (ver DocenteUnidadesService).
  publicado   Boolean  @default(false)
  // El docente marca este tema para que entre al DIAGNÓSTICO inicial. Solo temas
  // con enDiagnostico=true y ≥3 ítems de banco 'pretest' se evalúan en el pretest.
  enDiagnostico Boolean @default(false) @map("en_diagnostico")
  creadoEn    DateTime @default(now()) @map("creado_en")

  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  padre    Tema?  @relation("Subtemas", fields: [padreId], references: [id], onDelete: Cascade)
  subtemas Tema[] @relation("Subtemas")

  ejercicios          Ejercicio[]
  documentos          Documento[]
  retos               Reto[]
  progreso            ProgresoTema[]
  preguntasGeneradas  PreguntaGenerada[]
  intentosSubidaNivel IntentoSubidaNivel[]
  diagnosticos        DiagnosticoTema[]
  pretestRespuestas   PretestRespuesta[]
  logsAdaptacion      LogAdaptacion[]

  @@index([unidadId])
  @@index([padreId])
  @@map("temas")
}

// Progreso del estudiante por tema (análogo a ProgresoNivel, pero para la
// jerarquía académica real). Habilita el desbloqueo secuencial de temas/unidades.
model ProgresoTema {
  usuarioId             Int             @map("usuario_id")
  temaId                Int             @map("tema_id")
  ejerciciosCompletados Int             @default(0) @map("ejercicios_completados")
  desbloqueado          Boolean         @default(false)
  // Nivel ACTUAL del estudiante en ESTE tema (adaptatividad por ítem). Arranca en
  // la clasificación inicial del pretest y sube con el mini-diagnóstico. Puede
  // diferir entre temas (Intermedio en uno, Avanzado en otro).
  nivelActual           NivelDificultad @default(basico) @map("nivel_actual")
  actualizadoEn         DateTime        @default(now()) @map("actualizado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tema    Tema    @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, temaId])
  @@map("progreso_temas")
}

// ── Intento de SUBIR de nivel en un tema (mini-diagnóstico) ─
//  El estudiante puede intentar pasar Básico→Intermedio→Avanzado en un tema con
//  un mini-diagnóstico corto del nivel objetivo. Cada intento se registra
//  (aprobado/no, puntaje, fecha) como evidencia para la investigación y para el
//  control de cooldown entre intentos.
model IntentoSubidaNivel {
  id        Int             @id @default(autoincrement())
  usuarioId Int             @map("usuario_id")
  temaId    Int             @map("tema_id")
  desde     NivelDificultad
  hacia     NivelDificultad
  puntaje   Int             @default(0) // 0-100
  aprobado  Boolean         @default(false)
  fecha     DateTime        @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tema    Tema    @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@index([usuarioId, temaId, fecha])
  @@map("intentos_subida_nivel")
}

// Registro de la RUTA personalizada: cada ejercicio servido/resuelto por el
// estudiante, con la dificultad objetivo del momento. Evidencia de la
// adaptatividad para la tesis (secuencia + ajuste del nivel).
model PasoRuta {
  id                 Int      @id @default(autoincrement())
  usuarioId          Int      @map("usuario_id")
  ejercicioId        Int      @map("ejercicio_id")
  estrellas          Int      @default(0)
  dificultadObjetivo Int      @default(1) @map("dificultad_objetivo")
  correcto           Boolean  @default(false)
  fecha              DateTime @default(now())

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ejercicio Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, fecha])
  @@map("pasos_ruta")
}

// ── Control docente de la EVALUACIÓN FINAL (postest) por paralelo ──
//  Por defecto NO existe fila → el postest está DESHABILITADO. El docente lo
//  habilita para su paralelo cuando termina la intervención. Sin fila habilitada
//  el estudiante no puede entrar (control de acceso en el backend).
model PostestControl {
  paralelo      String    @id
  habilitado    Boolean   @default(false)
  habilitadoEn  DateTime? @map("habilitado_en")
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en")

  @@map("postest_control")
}

// Marca idempotente de que el estudiante ya recibió el bono de XP de la
// unidad (evita otorgarlo más de una vez al recalcular progreso).
model UnidadCompletada {
  usuarioId Int      @map("usuario_id")
  unidadId  Int      @map("unidad_id")
  fecha     DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidad  Unidad  @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  @@id([usuarioId, unidadId])
  @@map("unidades_completadas")
}

// ── Preguntas propuestas por PREXI desde un PDF (borrador) ─
//  NUNCA se publican solas: el docente las revisa, edita y aprueba. Solo al
//  aprobarlas se copian a `Ejercicio` (banco=practica, temaId=este tema).
model PreguntaGenerada {
  id                Int              @id @default(autoincrement())
  temaId            Int              @map("tema_id")
  autorId           Int              @map("autor_id") // docente dueño de la revisión
  documentoId       Int?             @map("documento_id") // PDF origen (trazabilidad)
  tipo              TipoEjercicio    @default(opcion_multiple)
  categoria         String           @default("General")
  enunciado         String
  codigoPython      String?          @map("codigo_python")
  opciones          Json             @default("[]")
  respuestaCorrecta String           @map("respuesta_correcta")
  explicacionIa     String?          @map("explicacion_ia")
  estado            EstadoPreguntaIa @default(borrador)
  // A qué banco y nivel irá al aprobarse. `examen` = pregunta integradora del
  // examen de la unidad (combina los temas de `temasIntegrados`).
  banco             Banco            @default(practica)
  nivelDificultad   NivelDificultad  @default(basico) @map("nivel_dificultad")
  temasIntegrados   Int[]            @default([]) @map("temas_integrados")
  ejercicioId       Int?             @map("ejercicio_id") // seteado al aprobar
  creadoEn          DateTime         @default(now()) @map("creado_en")

  tema      Tema       @relation(fields: [temaId], references: [id], onDelete: Cascade)
  autor     Usuario    @relation("AutorPreguntaIa", fields: [autorId], references: [id], onDelete: Cascade)
  documento Documento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  @@index([temaId, estado])
  @@map("preguntas_generadas")
}

// ── Niveles ─────────────────────────────────────────────────
model Nivel {
  id          Int     @id @default(autoincrement())
  numero      Int     @unique
  titulo      String
  descripcion String?
  umbral      Int     @default(12)

  ejercicios Ejercicio[]
  progreso   ProgresoNivel[]
  documentos Documento[]
  retos      Reto[]

  @@map("niveles")
}

// ── Ejercicios (práctica + bancos pretest/postest) ──────────
model Ejercicio {
  id                Int             @id @default(autoincrement())
  titulo            String
  categoria         String
  nivelId           Int             @map("nivel_id")
  // Ubicación en la jerarquía académica real (Unidad → Tema → Subtema).
  // Opcional: los bancos pretest/postest y ejercicios antiguos no la requieren.
  temaId            Int?            @map("tema_id")
  estrellas         Int             @default(3)
  // Nivel de dificultad adaptativo (Básico/Intermedio/Avanzado). Se deriva de
  // `estrellas` (★1-2=básico, ★3=intermedio, ★4-5=avanzado) en el seed, pero es
  // el campo autoritativo que filtra qué ve cada estudiante en un tema.
  nivelDificultad   NivelDificultad @default(basico) @map("nivel_dificultad")
  // DIFICULTAD b del ítem en el modelo de Rasch (IRT), en la escala de θ
  // (logits, típicamente −3..+3). Se siembra desde las estrellas/nivel
  // (src/irt: dificultadDesdeEstrellas) y se usa para estimar θ y para la
  // selección adaptativa (máxima información cuando b ≈ θ). Calibrable a futuro.
  dificultadB       Float           @default(0) @map("dificultad_b")
  tipo              TipoEjercicio   @default(opcion_multiple)
  enunciado         String
  codigoPython      String?         @map("codigo_python")
  // opcion_multiple/ordenar_lineas: [{ id:"A", texto:"15" }]. completar_codigo: [].
  opciones          Json            @default("[]")
  // opcion_multiple/completar_codigo: valor esperado (o variantes separadas por "|").
  // ordenar_lineas: orden correcto de ids separados por coma, ej. "B,A,D,C".
  respuestaCorrecta String          @map("respuesta_correcta")
  xp                Int             @default(50)
  explicacionIa     String?         @map("explicacion_ia")
  maxPistas         Int             @default(3) @map("max_pistas")
  banco             Banco           @default(practica)
  // El docente puede activar/desactivar un ejercicio. El estudiante solo ve los activos.
  activo            Boolean         @default(true)
  // Temas que INTEGRA la pregunta (ids de Tema). Las preguntas del examen de
  // unidad combinan 2 o 3 temas o subtemas; en práctica queda vacío.
  temasIntegrados   Int[]           @default([]) @map("temas_integrados")
  // TRAZABILIDAD al material oficial del docente (tesis): de qué parte de SU
  // documento salió este ítem. Forma: { unidad, tema, subtema?, paginaPDF, citaBreve }.
  fuenteDoc         Json?           @map("fuente_doc")
  creadoEn          DateTime        @default(now()) @map("creado_en")

  nivel             Nivel              @relation(fields: [nivelId], references: [id], onDelete: Cascade)
  tema              Tema?              @relation(fields: [temaId], references: [id], onDelete: SetNull)
  intentos          Intento[]
  pretestRespuestas PretestRespuesta[]
  pasosRuta         PasoRuta[]
  retosDerivados    Reto[]             @relation("RetosDerivados")
  logsAdaptacion    LogAdaptacion[]

  @@index([nivelId])
  @@index([temaId])
  @@index([temaId, nivelDificultad])
  @@index([banco])
  @@map("ejercicios")
}

// ── Intentos de práctica ────────────────────────────────────
model Intento {
  id            Int      @id @default(autoincrement())
  usuarioId     Int      @map("usuario_id")
  ejercicioId   Int      @map("ejercicio_id")
  respuestaDada String   @map("respuesta_dada")
  correcto      Boolean
  // Resultado graduado. `correcto` se conserva como derivado (estado = correcta)
  // para no romper las estadísticas existentes.
  estado        EstadoRespuesta @default(incorrecta)
  puntaje       Float    @default(0) // fracción de la pregunta obtenida (0..1)
  tiempoSeg     Int      @default(0) @map("tiempo_seg")
  pistasUsadas  Int      @default(0) @map("pistas_usadas")
  xpOtorgado    Int      @default(0) @map("xp_otorgado")
  fecha         DateTime @default(now())

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ejercicio Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([ejercicioId])
  @@index([fecha])
  // Índice COMPUESTO (usuario, fecha): es la forma real en que se consulta esta
  // tabla —el historial de UN estudiante ordenado por fecha, y la actividad de
  // los últimos N días—, y ninguno de los índices sueltos de arriba la resuelve
  // bien: con `usuarioId` solo, Postgres tiene que ordenar por fecha después;
  // con `fecha` solo, filtra por usuario a mano. `intentos` es la tabla que más
  // crece del sistema, así que es donde antes se nota.
  @@index([usuarioId, fecha])
  @@map("intentos")
}

// ── Progreso por nivel ──────────────────────────────────────
model ProgresoNivel {
  usuarioId             Int      @map("usuario_id")
  nivelId               Int      @map("nivel_id")
  ejerciciosCompletados Int      @default(0) @map("ejercicios_completados")
  desbloqueado          Boolean  @default(false)
  actualizadoEn         DateTime @default(now()) @map("actualizado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nivel   Nivel   @relation(fields: [nivelId], references: [id], onDelete: Cascade)

  @@id([usuarioId, nivelId])
  @@map("progreso_niveles")
}

// ── Evaluaciones pretest/postest (datos de investigación) ───
model Evaluacion {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuario_id")
  tipo         TipoTest
  puntajeTotal Int      @map("puntaje_total") // 0-100
  tiempoSeg    Int      @default(0) @map("tiempo_seg")
  porCategoria Json     @default("[]") @map("por_categoria") // [{categoria,aciertos,total,porcentaje}]
  fecha        DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tipo])
  @@map("pretest_postest")
}

// ── Consulta del RANKING (indicador conductual) ─────────────
//  La tesis operacionaliza "interacción en rankings → frecuencia de consulta
//  del ranking → logs del sistema", pero hasta ahora no se registraba nada: no
//  había forma de saber cuántas veces un estudiante miró su posición.
//
//  Es una tabla de bitácora deliberadamente mínima: quién y cuándo, más el
//  ámbito consultado. No guarda resultados ni posiciones —eso ya se puede
//  reconstruir— porque el indicador prometido es la FRECUENCIA, no el contenido.
model ConsultaRanking {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  ambito    String // global | paralelo | unidad…
  periodo   String // historico | semanal…
  fecha     DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, fecha])
  @@map("consultas_ranking")
}

// ── Encuesta de MOTIVACIÓN ACADÉMICA (escala Likert) ────────
//  Instrumento de la variable dependiente "motivación académica" de la tesis,
//  aplicado ANTES y DESPUÉS de la intervención para poder contrastar el cambio.
//
//  Se guarda una fila por estudiante × ítem × momento, no un puntaje agregado:
//  el análisis de fiabilidad (alfa de Cronbach) y el de ítems se calculan sobre
//  las respuestas individuales, igual que en el pretest. Guardar solo el total
//  impediría reportar la confiabilidad del instrumento.
//
//  `valor` es la puntuación Likert 1–5 TAL COMO LA MARCÓ el estudiante; la
//  recodificación de los ítems inversos se hace al puntuar, no al guardar, para
//  que el dato crudo quede siempre disponible y auditable.
model RespuestaEncuesta {
  usuarioId Int             @map("usuario_id")
  itemId    String          @map("item_id") // clave del ítem en el instrumento
  momento   MomentoEncuesta
  valor     Int // 1-5 (Likert), sin recodificar
  version   String // versión del instrumento, para no mezclar aplicaciones
  fecha     DateTime        @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, itemId, momento])
  @@index([usuarioId, momento])
  @@map("respuestas_encuesta")
}

enum MomentoEncuesta {
  pre
  post
}

// ── Respuestas individuales de pretest/postest (autosave) ───
model PretestRespuesta {
  usuarioId   Int      @map("usuario_id")
  ejercicioId Int      @map("ejercicio_id")
  tipo        TipoTest @default(pre)
  opcionDada  String   @default("") @map("opcion_dada")
  correcto    Boolean  @default(false)
  categoria   String
  // Tema del temario al que pertenece el ítem (diagnóstico por tema). Opcional:
  // el postest y datos legados no lo requieren.
  temaId      Int?     @map("tema_id")
  fecha       DateTime @default(now())

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ejercicio Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)
  tema      Tema?     @relation(fields: [temaId], references: [id], onDelete: SetNull)

  @@id([usuarioId, ejercicioId, tipo])
  @@index([temaId])
  @@map("pretest_respuestas")
}

// ── Diagnóstico inicial DESGLOSADO POR TEMA (permanente, investigación) ──
//  Resultado del pretest para cada tema evaluado: puntaje, habilidad θ estimada
//  por IRT (Rasch) y nivel inicial clasificado (Básico/Intermedio/Avanzado). Es
//  el instrumento de medición del ANTES por tema: se fija una vez y no cambia
//  (el nivel que evoluciona es ProgresoTema.nivelActual).
model DiagnosticoTema {
  usuarioId Int             @map("usuario_id")
  temaId    Int             @map("tema_id")
  theta     Float? // habilidad estimada por IRT (logits); null si sin ítems con b
  nivel     NivelDificultad @default(basico)
  aciertos  Int             @default(0)
  total     Int             @default(0)
  puntaje   Int             @default(0) // 0-100
  creadoEn  DateTime        @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tema    Tema    @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, temaId])
  @@index([temaId])
  @@map("diagnostico_temas")
}

// ── Repaso previo al EXAMEN DE FIN DE UNIDAD (gate por unidad) ──
//  Marca que el estudiante revisó el repaso de la unidad; el examen solo se
//  habilita tras ello (análogo a Usuario.repasoPostestCompletado, pero por unidad).
model RepasoUnidad {
  usuarioId Int      @map("usuario_id")
  unidadId  Int      @map("unidad_id")
  revisadoEn DateTime @default(now()) @map("revisado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidad  Unidad  @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  @@id([usuarioId, unidadId])
  @@map("repasos_unidad")
}

// ── EXAMEN DE FIN DE UNIDAD (instrumento interno de avance) ──
//  Cada intento del estudiante en el examen de una unidad. Es la FUENTE DEL GATE
//  de avance (existe un intento aprobado ⇒ se desbloquea la siguiente unidad) y
//  el registro para la investigación (θ IRT, nivel, puntaje, aprobado, fecha).
model ExamenUnidad {
  id        Int             @id @default(autoincrement())
  usuarioId Int             @map("usuario_id")
  unidadId  Int             @map("unidad_id")
  theta     Float? // habilidad estimada por IRT (Rasch) en el examen
  nivel     NivelDificultad @default(basico) // nivel de dominio derivado de θ
  puntaje   Int             @default(0) // 0-100
  aprobado  Boolean         @default(false) // nivel ≥ Intermedio
  aciertos  Int             @default(0)
  total     Int             @default(0)
  // Detalle por pregunta: [{ ejercicioId, titulo, tema, estado, puntaje }].
  // Lo ve el docente en la ficha del estudiante.
  detalle   Json?
  fecha     DateTime        @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidad  Unidad  @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  @@index([usuarioId, unidadId, fecha])
  @@map("examenes_unidad")
}

// ── Ranking ─────────────────────────────────────────────────
model Ranking {
  usuarioId       Int       @id @map("usuario_id")
  xpTotal         Int       @default(0) @map("xp_total")
  rachaDias       Int       @default(0) @map("racha_dias")
  ultimaActividad DateTime? @map("ultima_actividad") @db.Date
  posicion        Int?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("ranking")
}

// ── Logros / Emblemas ───────────────────────────────────────
//  Cada emblema se obtiene al cumplir un REQUISITO concreto. `condicion` es el
//  texto legible del requisito; `svgKey` selecciona el ícono SVG ORIGINAL que
//  dibuja el frontend (nada de assets de juegos con copyright). El otorgamiento
//  siempre se valida en el backend (EmblemasService), sin duplicar (constraint
//  en LogroUsuario).
model Logro {
  id          Int            @id @default(autoincrement())
  clave       String         @unique
  nombre      String
  condicion   String // requisito legible: "Completa un tema sin fallar"
  descripcion String         @default("") // texto motivador adicional
  icono       String         @default("") // compatibilidad; la interfaz usa svgKey.
  svgKey      String         @default("estrella") // ícono SVG original a renderizar
  categoria   String         @default("general") // constancia | precision | velocidad | maestria | especial
  orden       Int            @default(0)
  usuarios    LogroUsuario[]

  @@map("logros")
}

// ── Rangos de programador (catálogo por desempeño) ──────────
//  Estética de videojuego con SVG originales. El rango de un estudiante en cada
//  unidad se DERIVA de su desempeño real (DesempenoUnidad.puntaje ≥ umbral).
model Rango {
  id     Int    @id @default(autoincrement())
  clave  String @unique // aprendiz | junior | semi_senior | senior | arquitecto | maestro
  nombre String
  orden  Int    @unique // 1..6 (mayor = mejor)
  umbral Int // puntaje mínimo (0-100) del desempeño de la unidad para alcanzarlo
  svgKey String @default("escudo_1")
  color  String @default("#3B6291") // color del escudo (paleta sobria)

  @@map("rangos")
}

// ── Desempeño del estudiante por UNIDAD (para rango + progreso) ──
//  Se recalcula en el backend tras cada intento. `puntaje` (0-100) combina
//  tasa de acierto, temas completados y racha; de él se deriva `rangoClave`.
model DesempenoUnidad {
  usuarioId           Int             @map("usuario_id")
  unidadId            Int             @map("unidad_id")
  ejerciciosResueltos Int             @default(0) @map("ejercicios_resueltos")
  ejerciciosTotal     Int             @default(0) @map("ejercicios_total")
  temasCompletados    Int             @default(0) @map("temas_completados")
  temasTotal          Int             @default(0) @map("temas_total")
  aciertoPct          Int             @default(0) @map("acierto_pct")
  postestPct          Int?            @map("postest_pct") // % del postest global (proxy de dominio)
  puntaje             Int             @default(0) // 0-100
  rangoClave          String          @default("aprendiz") @map("rango_clave")
  // Dominio AGREGADO de la unidad (agregación difusa del nivelActual de sus temas
  // ponderado por avance). Gobierna el avance de unidad: se exige ≥ intermedio
  // para desbloquear la siguiente unidad.
  dominioPct          Int             @default(0) @map("dominio_pct")
  nivelDominio        NivelDificultad @default(basico) @map("nivel_dominio")
  actualizadoEn       DateTime        @default(now()) @updatedAt @map("actualizado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidad  Unidad  @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  @@id([usuarioId, unidadId])
  @@map("desempeno_unidad")
}

model LogroUsuario {
  usuarioId     Int      @map("usuario_id")
  logroId       Int      @map("logro_id")
  fechaObtenido DateTime @default(now()) @map("fecha_obtenido")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  logro   Logro   @relation(fields: [logroId], references: [id], onDelete: Cascade)

  @@id([usuarioId, logroId])
  @@map("logros_usuario")
}

// ── Consultas a la IA (rate limit + auditoría + dato para la tesis) ──
//  Registra cada consulta a PREXI para: (1) limitar uso por hora,
//  (2) analizar qué temas generan más dudas, (3) penalizar XP por pistas.
model ConsultaIa {
  id          Int      @id @default(autoincrement())
  usuarioId   Int      @map("usuario_id")
  tipo        String   @default("asistente") // asistente | retroalimentacion | pista | practica
  endpoint    String   @default("")
  pregunta    String?  @db.Text
  respuesta   String?  @db.Text
  ejercicioId Int?     @map("ejercicio_id") // contexto (retro/pista) para análisis y penalización
  nivelPista  Int?     @map("nivel_pista") // 1|2|3 cuando tipo = pista
  fecha       DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, fecha])
  @@index([usuarioId, ejercicioId, tipo])
  @@map("consultas_ia")
}

// ── Documentos del curso (PDFs subidos por docentes) ────────
model Documento {
  id            Int      @id @default(autoincrement())
  titulo        String
  descripcion   String?
  archivo       String // nombre OPACO (UUID.pdf); identifica el archivo, no una ruta
  // Binario del PDF. Vive DENTRO de la base y no en disco: el hosting gratuito
  // (Render Free) tiene filesystem efímero y perdería el archivo en cada
  // reinicio. Como efecto secundario, el PDF entra en el respaldo `pg_dump`.
  // Nullable solo por los registros anteriores a este cambio, que aún leen de
  // disco como respaldo.
  contenido     Bytes?
  tamanoBytes   Int      @map("tamano_bytes")
  nivelId       Int?     @map("nivel_id")
  // Tema asociado: PREXI lo usa como CONTEXTO (estilo/sintaxis del docente) y
  // es la fuente para "Generar preguntas desde este PDF".
  temaId        Int?     @map("tema_id")
  // Texto extraído del PDF (best-effort, cacheado para no re-parsear en cada
  // consulta de PREXI ni en cada generación de preguntas).
  textoExtraido String?  @map("texto_extraido") @db.Text
  subidoPorId   Int      @map("subido_por_id")
  creadoEn      DateTime @default(now()) @map("creado_en")

  nivel              Nivel?             @relation(fields: [nivelId], references: [id], onDelete: SetNull)
  tema               Tema?              @relation(fields: [temaId], references: [id], onDelete: SetNull)
  subidoPor          Usuario            @relation("DocenteDocumentos", fields: [subidoPorId], references: [id], onDelete: Cascade)
  preguntasGeneradas PreguntaGenerada[]

  @@index([temaId])
  @@map("documentos")
}

// ── Retos del docente (ejercicios extra) ────────────────────
// Catálogo de bugs que el generador puede introducir en un reto de depuración.
// Se guarda cuál se aplicó para que el docente (y PREXI) sepan qué se busca.
enum TipoBug {
  operador_aritmetico_invertido
  operador_relacional_invertido
  limite_rango_corrido
  orden_lineas_intercambiado
  variable_trocada
}

model Reto {
  id                Int           @id @default(autoincrement())
  // Código de negocio del reto DERIVADO del banco (ej. "R1.5.I.06-DEP"). Null en
  // los retos que escribe el docente a mano. Es la clave del upsert del generador.
  codigo            String?       @unique
  titulo            String
  categoria         String
  // Nivel temático asociado (opcional). Solo referencia; el reto vive fuera de los 5 niveles.
  nivelId           Int?          @map("nivel_id")
  // Tema (jerarquía académica) al que pertenece el reto. El estudiante ve los
  // retos AGRUPADOS por Unidad → Tema → Subtema a partir de este campo (un
  // subtema es un Tema con padre_id, igual que en Documento). Opcional: sin tema
  // → sección "General".
  temaId            Int?          @map("tema_id")
  estrellas         Int           @default(3)
  tipo              TipoEjercicio @default(completar_codigo)
  enunciado         String
  codigoInicial     String?       @map("codigo_inicial")
  // Ejemplo de entrada/salida esperada (guía para el estudiante).
  ejemploEntrada    String?       @map("ejemplo_entrada")
  ejemploSalida     String?       @map("ejemplo_salida")
  opciones          Json          @default("[]")
  respuestaCorrecta String?       @map("respuesta_correcta")
  xp                Int           @default(50)
  // Fecha límite opcional para entregar el reto.
  fechaLimite       DateTime?     @map("fecha_limite")
  autorId           Int           @map("autor_id")
  // Publicar/despublicar un reto. El estudiante solo ve los publicados (activos).
  activo            Boolean       @default(true)
  // MISIÓN DE DEPURACIÓN (bug‑hunt): el código inicial trae un bug plantado; el
  // estudiante lo corrige y el sistema AUTO‑VALIDA comparando la salida con
  // `ejemploSalida` (sin revisión del docente). Otorga el emblema "Cazador de Bugs".
  esBugHunt         Boolean       @default(false) @map("es_bug_hunt")

  // ── RETOS DERIVADOS DEL BANCO (generados por prisma/generar-retos.ts) ──
  //  Un reto derivado NUNCA inventa contenido: nace de un Ejercicio ya validado
  //  del banco oficial y reutiliza sus valores y su salida esperada. El enlace al
  //  origen es lo que permite (1) citar la teoría correcta desde PREXI y (2)
  //  ofrecer al estudiante "repasa el ejercicio del que salió este reto".
  origenEjercicioId Int?          @map("origen_ejercicio_id")
  // Nivel adaptativo del reto: SIEMPRE el del ejercicio origen. Gobierna a quién
  // se le muestra (debe coincidir con ProgresoTema.nivelActual de ese tema).
  nivelDificultad   NivelDificultad @default(basico) @map("nivel_dificultad")
  // Qué transformación se aplicó al código original (solo en depuración).
  tipoBug           TipoBug?      @map("tipo_bug")
  // Pistas progresivas 1→3 redactadas desde el material del ejercicio origen.
  // PREXI las usa como plan de escalamiento (nunca salta a la 3 de entrada).
  pistas            Json          @default("[]")
  // Se corrige SOLO comparando la salida (sin revisión docente). Los retos
  // derivados nacen así; los del docente siguen yendo a revisión manual.
  autoCalificable   Boolean       @default(false) @map("auto_calificable")

  // TRAZABILIDAD al material oficial (Guía de Práctica): { unidad, tema, subtema?, paginaPDF, citaBreve }.
  fuenteDoc         Json?         @map("fuente_doc")
  creadoEn          DateTime      @default(now()) @map("creado_en")

  autor           Usuario       @relation("DocenteRetos", fields: [autorId], references: [id], onDelete: Cascade)
  nivel           Nivel?        @relation(fields: [nivelId], references: [id], onDelete: SetNull)
  tema            Tema?         @relation(fields: [temaId], references: [id], onDelete: SetNull)
  origenEjercicio Ejercicio?    @relation("RetosDerivados", fields: [origenEjercicioId], references: [id], onDelete: SetNull)
  resueltos       RetoUsuario[]

  @@index([temaId])
  @@index([temaId, nivelDificultad])
  @@index([origenEjercicioId])
  @@map("retos")
}

// Entrega de un reto: el estudiante lo entrega (pendiente_revision, sin XP) y el
// docente lo revisa (aprobado/necesita_mejorar) otorgando XP y feedback. `resuelto`
// se mantiene como "aprobado" (contador de resueltos del docente).
model RetoUsuario {
  usuarioId       Int           @map("usuario_id")
  retoId          Int           @map("reto_id")
  resuelto        Boolean       @default(false)
  estado          EstadoEntrega @default(sin_entregar)
  codigoEntregado String?       @map("codigo_entregado")
  feedbackDocente String?       @map("feedback_docente") @db.Text
  xpObtenido      Int           @default(0) @map("xp_obtenido")
  entregadoEn     DateTime?     @map("entregado_en")
  revisadoEn      DateTime?     @map("revisado_en")
  fecha           DateTime      @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  reto    Reto    @relation(fields: [retoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, retoId])
  @@index([retoId, estado])
  @@map("retos_usuario")
}

// Notificaciones del estudiante (campana de la topbar). Ej.: el docente revisó
// una entrega de reto. `enlace` apunta al contenido (ruta del frontend).
model Notificacion {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  tipo      String   @default("reto_revisado") // reto_revisado | ...
  titulo    String
  mensaje   String   @db.Text
  enlace    String? // ruta del frontend (ej. /retos)
  refId     Int?     @map("ref_id") // id del contenido relacionado (ej. retoId)
  leida     Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, leida])
  @@index([usuarioId, creadoEn])
  @@map("notificaciones")
}

// ── Nota del docente sobre un estudiante (observación de seguimiento) ─
//  Una nota por par (docente, estudiante). Solo su autor la edita/lee.
model NotaDocente {
  estudianteId  Int      @map("estudiante_id")
  docenteId     Int      @map("docente_id")
  texto         String   @db.Text
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  estudiante Usuario @relation("NotasRecibidas", fields: [estudianteId], references: [id], onDelete: Cascade)
  docente    Usuario @relation("NotasEscritas", fields: [docenteId], references: [id], onDelete: Cascade)

  @@id([estudianteId, docenteId])
  @@index([docenteId])
  @@map("notas_docente")
}

// ── Código de la zona de práctica (guardado del estudiante) ─
model CodigoPractica {
  id            Int            @id @default(autoincrement())
  usuarioId     Int            @map("usuario_id")
  contexto      ContextoCodigo @default(libre)
  refId         Int?           @map("ref_id") // ejercicioId o retoId según contexto
  codigo        String
  ultimaSalida  String?        @map("ultima_salida")
  actualizadoEn DateTime       @updatedAt @map("actualizado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("codigo_practica")
}

// ── Configuración del sistema (fila única id=1) ─────────────
//  ÚNICA fuente de parámetros: estudiante, docente e IA leen desde aquí (nada
//  hardcodeado). Solo el admin la edita (rutas /admin/config).
model ConfiguracionSistema {
  id Int @id @default(1)

  // General.
  nombreSistema String  @default("PREXI") @map("nombre_sistema")
  institucion   String  @default("UPEA") @map("institucion")
  periodo       String  @default("") @map("periodo") // semestre/periodo activo
  logoUrl       String? @map("logo_url")

  // Gamificación.
  xpPorEjercicio    Int @default(50) @map("xp_por_ejercicio")
  xpBonusRacha      Int @default(10) @map("xp_bonus_racha")
  xpPorLogro        Int @default(20) @map("xp_por_logro")
  umbralPorcentaje  Int @default(80) @map("umbral_porcentaje") // umbral de desbloqueo de nivel (%)
  penalizacionPista Int @default(5) @map("penalizacion_pista")

  // Adaptatividad por niveles (Básico/Intermedio/Avanzado).
  subirNivelPreguntas   Int @default(10) @map("subir_nivel_preguntas") // nº de ítems del mini-diagnóstico
  subirNivelUmbral      Int @default(80) @map("subir_nivel_umbral") // % para aprobar y subir de nivel
  subirNivelEsperaHoras Int @default(0) @map("subir_nivel_espera_horas") // cooldown entre intentos (0 = sin espera)
  // PRÁCTICA MÍNIMA por nivel antes de habilitar el mini-diagnóstico de subida
  // (y, con él, el avance al siguiente tema). Se cuentan ejercicios RESUELTOS
  // del nivel vigente en ESE tema, no intentos. Los valores por defecto van
  // contra la composición del banco (15/10/5 por tema, regla 1 de la auditoría):
  // 10 de 15 en Básico, 7 de 10 en Intermedio y los 5 de 5 en Avanzado.
  // Son configurables a propósito: el docente ajusta la exigencia sin tocar código.
  minPracticaBasico     Int @default(10) @map("min_practica_basico")
  minPracticaIntermedio Int @default(10) @map("min_practica_intermedio")
  minPracticaAvanzado   Int @default(10) @map("min_practica_avanzado")
  // Examen de FIN DE UNIDAD (gate de avance a la siguiente unidad).
  examenUnidadPreguntas   Int @default(10) @map("examen_unidad_preguntas") // nº de ítems del examen
  examenUnidadEsperaHoras Int @default(0) @map("examen_unidad_espera_horas") // cooldown entre reintentos
  // XP: estar en un nivel más alto otorga MÁS XP (porcentaje sobre el XP base;
  // básico = 100%). Incentivo a esforzarse (hipótesis de la tesis).
  xpFactorIntermedio    Int @default(125) @map("xp_factor_intermedio")
  xpFactorAvanzado      Int @default(150) @map("xp_factor_avanzado")

  // ── Acceso a RETOS (editor de código libre) ──
  //  INTERRUPTOR GENERAL: el docente decide si el módulo Retos está activo. Ya NO
  //  decide el nivel: cada reto se muestra al estudiante cuyo nivel EN ESE TEMA
  //  (ProgresoTema.nivelActual) coincide con el del reto, igual que los ejercicios.
  //  Lo gobierna el motor adaptativo, no una lista de permisos.
  retosHabilitado Boolean @default(false) @map("retos_habilitado")
  // OBSOLETOS (regla anterior: θ global + habilitación por nivel). Se conservan
  // para no perder la configuración del docente al migrar; no gobiernan el acceso.
  retosIntermedioHabilitado Boolean @default(false) @map("retos_intermedio_habilitado")
  retosAvanzadoHabilitado   Boolean @default(false) @map("retos_avanzado_habilitado")

  // Inteligencia Artificial (PREXI).
  iaActiva              Boolean @default(true) @map("ia_activa")
  maxPistasIa           Int     @default(3) @map("max_pistas_ia")
  rateLimitIaHora       Int     @default(20) @map("rate_limit_ia_hora") // consultas/hora por estudiante
  modoRetroalimentacion String  @default("inmediata") @map("modo_retroalimentacion") // inmediata | al_finalizar
  modeloIa              String  @default("gemini-3.5-flash-lite") @map("modelo_ia")

  // Evaluación final.
  postestDesdeNivel Int     @default(3) @map("postest_desde_nivel")
  // Encuesta de motivación (MSLQ): funcionalidad del sistema NO empleada en la
  // investigación (ver docs/INSTRUMENTO_MOTIVACION.md). Apagada por defecto.
  encuestaMotivacionActiva Boolean @default(false) @map("encuesta_motivacion_activa")

  // ── Investigación (diseño no experimental transversal) ──
  // RANGO OBJETIVO del motor adaptativo, en % de probabilidad de acierto esperada.
  // Una asignación está "en rango" si rangoObjetivoMin ≤ P ≤ rangoObjetivoMax.
  rangoObjetivoMin Int @default(50) @map("rango_objetivo_min")
  rangoObjetivoMax Int @default(85) @map("rango_objetivo_max")
  // FASE DE EVALUACIÓN: al activarla, a cada usuario le aparece el cuestionario
  // que le corresponde (SUS a estudiantes, ISO/IEC 25010 a docentes/evaluadores).
  faseEvaluacionActiva Boolean @default(false) @map("fase_evaluacion_activa")
  // CRITERIOS DE ACEPTACIÓN de la hipótesis (los tres deben cumplirse a la vez):
  //  · precisión: el LÍMITE INFERIOR del IC 95 % del % en rango objetivo ≥ este valor.
  //  · usabilidad: puntaje medio SUS ≥ este valor (69 = inicio del rango "bueno").
  //  · calidad: TODAS las características ISO/IEC 25010 con media ≥ nivel aceptable.
  criterioPrecisionMin   Int   @default(70) @map("criterio_precision_min")
  criterioSusMin         Int   @default(69) @map("criterio_sus_min")
  nivelAceptableCalidad  Float @default(4) @map("nivel_aceptable_calidad")

  // Detección de estudiantes "en riesgo" (configurable, centralizado aquí).
  riesgoDiasInactivo   Int @default(7) @map("riesgo_dias_inactivo") // días sin actividad
  riesgoTasaAciertoMin Int @default(40) @map("riesgo_tasa_acierto_min") // % mínimo de aciertos
  riesgoMinIntentos    Int @default(4) @map("riesgo_min_intentos") // intentos mínimos para evaluar la tasa

  @@map("configuracion_sistema")
}

// ── Auditoría de acciones sensibles del admin ───────────────
//  Trazabilidad para la seriedad del estudio: quién cambió qué y cuándo.
model LogAuditoria {
  id        Int      @id @default(autoincrement())
  actorId   Int      @map("actor_id")
  accion    String // usuario_crear | usuario_editar | usuario_estado | rol_cambiar | config_cambiar | password_reset
  entidad   String   @default("") // usuario | configuracion
  entidadId Int?     @map("entidad_id")
  detalle   String   @default("") @db.Text
  fecha     DateTime @default(now())

  actor Usuario @relation("AuditoriaActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([accion, fecha])
  @@index([fecha])
  @@map("log_auditoria")
}

// ── LOG DEL MOTOR ADAPTATIVO (instrumento de la tesis: precisión y latencia) ──
//  Una fila por cada DECISIÓN del motor, es decir, por cada ejercicio de
//  práctica que el sistema asignó y el estudiante respondió. Es el "registro de
//  logs del sistema" del que salen dos indicadores de la variable dependiente
//  "precisión del motor adaptativo":
//
//   · Ajuste de dificultad → `enRangoObjetivo`: la probabilidad de acierto
//     esperada P = 1/(1+e^-(θ−b)) del ejercicio asignado, calculada con la θ que
//     el estudiante tenía ANTES de responder, cae dentro del rango objetivo
//     (ConfiguracionSistema.rangoObjetivoMin/Max).
//   · Latencia de reajuste → `latenciaMs`: desde que llega la respuesta hasta
//     que el sistema tiene re-estimada la habilidad (la nueva dificultad).
//
//  Y dos de la variable independiente: `personalizado` (¿el ejercicio se
//  seleccionó según el nivel/θ del estudiante?) y `tiempoRespuestaMs` (desde que
//  llega la respuesta hasta que la retroalimentación está lista para enviarse).
//
//  Los tiempos se miden en el BACKEND (process.hrtime), nunca en el cliente.
//  Fórmulas en docs/DISENO_INVESTIGACION.md y docs/IRT.md.
model LogAdaptacion {
  id          Int  @id @default(autoincrement())
  usuarioId   Int  @map("usuario_id")
  temaId      Int? @map("tema_id")
  ejercicioId Int  @map("ejercicio_id")

  thetaAntes   Float? @map("theta_antes") // null si el estudiante aún no tenía θ
  thetaDespues Float? @map("theta_despues")
  dificultadB  Float  @map("dificultad_b")
  probAcierto  Float? @map("prob_acierto") // P esperada con thetaAntes; null sin θ

  nivelAntes   NivelDificultad? @map("nivel_antes")
  nivelDespues NivelDificultad? @map("nivel_despues")
  // null = no evaluable (sin θ previa): se excluye del denominador, no cuenta como fallo.
  enRangoObjetivo Boolean? @map("en_rango_objetivo")
  // true = servido por la ruta adaptativa (filtrado por nivel y ordenado por θ).
  personalizado   Boolean  @default(false)
  correcto        Boolean

  latenciaMs        Int @map("latencia_ms")
  tiempoRespuestaMs Int @map("tiempo_respuesta_ms")

  fecha DateTime @default(now())

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ejercicio Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)
  tema      Tema?     @relation(fields: [temaId], references: [id], onDelete: SetNull)

  @@index([usuarioId, fecha])
  @@index([temaId])
  @@map("log_adaptacion")
}

// ── CAMBIOS DE POSICIÓN EN EL RANKING (indicador de gamificación) ──
//  Una fila cada vez que la posición de un estudiante cambia al recalcularse el
//  ranking. La tesis operacionaliza la gamificación como "retos completados y
//  cambios de posición en el ranking (cantidad)".
model HistorialRanking {
  id              Int      @id @default(autoincrement())
  usuarioId       Int      @map("usuario_id")
  posicionAntes   Int?     @map("posicion_antes") // null = primera vez que entra al ranking
  posicionDespues Int      @map("posicion_despues")
  fecha           DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, fecha])
  @@map("historial_ranking")
}

// ── RESPUESTAS A LOS INSTRUMENTOS DE VALORACIÓN (SUS e ISO/IEC 25010) ──
//  Una fila por persona × ítem. Se guarda el valor Likert 1–5 TAL COMO SE
//  MARCÓ; la transformación (p. ej. la polaridad alterna del SUS) se aplica al
//  puntuar, para que el dato crudo quede siempre auditable.
//
//  La clave primaria incluye la `version` del instrumento: garantiza UNA sola
//  aplicación por usuario y versión, y evita mezclar aplicaciones si los ítems
//  cambian.
//
//   · SUS      → lo responden los ESTUDIANTES (usabilidad percibida).
//   · ISO25010 → lo responden DOCENTES del área y evaluadores con formación en
//                ingeniería de software (calidad del producto).
model RespuestaInstrumento {
  usuarioId   Int      @map("usuario_id")
  instrumento String // SUS | ISO25010
  itemId      String   @map("item_id")
  valor       Int // 1-5 (Likert), sin transformar
  version     String
  fecha       DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, instrumento, itemId, version])
  @@index([instrumento, version])
  @@map("respuestas_instrumento")
}

// ── MATERIA y PARALELO (organización del curso) ─────────────
//  El docente registra a sus estudiantes dentro de un PARALELO de una MATERIA
//  y puede asignarse como docente de ese paralelo. El estudiante ve en su
//  panel "Materia · Paralelo · Docente".
model Materia {
  id       Int      @id @default(autoincrement())
  nombre   String // ej. "Programación I"
  sigla    String? // ej. "PRG-111"
  gestion  String // ej. "2026-II"
  creadoEn DateTime @default(now()) @map("creado_en")

  paralelos Paralelo[]

  @@unique([nombre, gestion])
  @@map("materias")
}

model Paralelo {
  id        Int      @id @default(autoincrement())
  materiaId Int      @map("materia_id")
  nombre    String // "A", "B", "C"…
  // Docente a cargo. Null = paralelo aún sin docente asignado.
  docenteId Int?     @map("docente_id")
  creadoEn  DateTime @default(now()) @map("creado_en")

  materia     Materia   @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  docente     Usuario?  @relation("DocenteParalelos", fields: [docenteId], references: [id], onDelete: SetNull)
  estudiantes Usuario[] @relation("EstudiantesParalelo")

  @@unique([materiaId, nombre])
  @@index([docenteId])
  @@map("paralelos")
}

// ── HABILITACIÓN MANUAL del examen de fin de unidad ─────────
//  El examen de la unidad se habilita SOLO cuando el estudiante completó todos
//  los temas y subtemas con nivel Intermedio o superior. Si no llegó, su docente
//  puede habilitarlo a mano (por ejemplo, a quien quedó cerca). Queda registrado
//  quién lo habilitó, cuándo y con qué promedio iba el estudiante.
model HabilitacionExamen {
  usuarioId Int      @map("usuario_id")
  unidadId  Int      @map("unidad_id")
  docenteId Int?     @map("docente_id")
  promedio  Int? // promedio general del estudiante al momento de habilitarlo
  fecha     DateTime @default(now())

  usuario Usuario  @relation("HabilitacionEstudiante", fields: [usuarioId], references: [id], onDelete: Cascade)
  unidad  Unidad   @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  docente Usuario? @relation("HabilitacionDocente", fields: [docenteId], references: [id], onDelete: SetNull)

  @@id([usuarioId, unidadId])
  @@index([unidadId])
  @@map("habilitaciones_examen")
}
