# ── PREXI — Variables de PRODUCCIÓN (VPS) ───────────────────
# Copia este archivo a  .env  en el servidor y completa los valores REALES.
# El .env está en .gitignore: nunca se sube a git.

# Tu subdominio (DuckDNS u otro) ya apuntando a la IP pública del servidor.
DOMINIO=tuprexi.duckdns.org

# Secreto para firmar los JWT. Genera uno con:  openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTO_por_un_secreto_largo_y_aleatorio

# Contraseña de PostgreSQL (interna; cámbiala por algo tuyo).
DB_PASSWORD=cambia_esta_clave_de_bd

# Clave de Google Gemini (la que ya usas). Modelo con cuota disponible.
GEMINI_API_KEY=tu_clave_de_gemini
GEMINI_MODEL=gemini-2.5-flash-lite

# Límite interno de consultas al tutor PREXI por estudiante/hora.
AI_RATE_LIMIT_PER_HOUR=20
